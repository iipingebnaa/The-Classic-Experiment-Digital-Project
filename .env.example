
# BASE URL (change per environment)

# DEVELOPMENT
# NEXT_PUBLIC_API_BASE_URL=http://localhost:7900/api

# STAGING
# NEXT_PUBLIC_API_BASE_URL=https://staging.oxygen.siskusserver.com/api

# PRODUCTION
# NEXT_PUBLIC_API_BASE_URL=https://oxygen.siskusserver.com/api


# AUTH (API-001)

NEXT_PUBLIC_API_REGISTER=/register
NEXT_PUBLIC_API_FORGOT_PASSWORD=/forgot-password
NEXT_PUBLIC_API_RESET_PASSWORD=/reset-password
NEXT_PUBLIC_API_VERIFY_CODE=/verify-code

# CUSTOMERS (for login by phone)
NEXT_PUBLIC_API_CUSTOMER=/customers


# ORDERS (API-002)

NEXT_PUBLIC_API_SALES_ORDER=/sales_order
NEXT_PUBLIC_API_SALES_ORDER_BY_ID=/sales_order/:orderId
NEXT_PUBLIC_API_SALES_ORDER_BY_USER=/sales_order/:userId
NEXT_PUBLIC_API_SALES_ORDER_STATUS=/sales_order/status/:orderId
NEXT_PUBLIC_API_UPDATE_SALES_ORDER=/sales_order/:orderId


# BILLING (API-003)

NEXT_PUBLIC_API_INVOICE=/invoice/:orderId
NEXT_PUBLIC_API_PAYMENT=/payment


# SERVICES (API-004)

NEXT_PUBLIC_API_SERVICES=/services


# USER INFO (for Invoice "Bill To")

NEXT_PUBLIC_USER_ID=
NEXT_PUBLIC_USERNAME=
NEXT_PUBLIC_USER_CELLPHONE=
